# Build output (build\build.ps1 writes releases to dist\)
*.exe
dist/

# Tray app frontend: dependencies and build output (npm run build)
app/frontend/node_modules/
app/frontend/dist/

# Local development roots (EBUR_ROOT=.devroot, .devroot-fresh, ...)
.devroot*/

# Downloaded runtimes and generated spike state
spikes/runtimes/
spikes/*/work/

# Local CA and site keys must never be committed
spikes/https/ssl/
*.pem
*-key.pem
*.exe~
